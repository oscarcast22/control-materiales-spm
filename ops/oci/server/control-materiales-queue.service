[Unit]
Description=Cola de Control de Materiales SPM
After=network.target postgresql.service
ConditionPathExists=/srv/control-materiales/current/artisan

[Service]
Type=simple
User=materiales
Group=www-data
WorkingDirectory=/srv/control-materiales/current
ExecStart=/usr/bin/php artisan queue:work --sleep=3 --tries=3 --backoff=60 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=3600
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
